---
// The landing page's terminal: one tab per scene of src/data/terminal.json,
// recorded from the real command (scripts/terminal.mjs). Tabs work without
// JavaScript (radio inputs); the script only types the lines in turn, and
// not at all when the reader prefers reduced motion.
import data from "../data/terminal.json";

const { scenes } = data;
---

<div class="term not-content" data-terminal>
  <div class="bar" aria-hidden="true">
    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
  </div>
  {
    scenes.map((s, i) => (
      <input
        type="radio"
        name="term-scene"
        id={`term-${s.id}`}
        class="tab-input"
        checked={i === 0}
        aria-label={s.title}
      />
    ))
  }
  <div class="tabs" role="presentation">
    {scenes.map((s) => <label for={`term-${s.id}`}>{s.title}</label>)}
  </div>
  {
    scenes.map((s) => (
      <pre class={`scene scene-${s.id}`} data-scene={s.id} tabindex="0"><code>{s.lines.map((l) => (
        <span class={`line ${l.kind}`}>{l.kind === "cmd" ? <span class="prompt" aria-hidden="true">$ </span> : null}{l.text}{"\n"}</span>
      ))}</code></pre>
    ))
  }
</div>

<style>
  .term {
    --term-bg: #0d1117;
    --term-fg: #d1d9e0;
    --term-dim: #8b949e;
    --term-accent: #7ee787;
    background: var(--term-bg);
    color: var(--term-fg);
    border-radius: 0.6rem;
    border: 1px solid #30363d;
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 0.35);
    overflow: hidden;
    text-align: start;
    max-width: 100%;
  }
  .bar {
    display: flex;
    gap: 0.4rem;
    padding: 0.6rem 0.8rem 0;
  }
  .dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #30363d;
  }
  .tab-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.5rem 0.8rem;
    border-bottom: 1px solid #30363d;
  }
  .tabs label {
    cursor: pointer;
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border-radius: 0.3rem;
    color: var(--term-dim);
  }
  .scene {
    display: none;
    margin: 0;
    padding: 1rem;
    height: 26rem;
    overflow: auto;
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    background: transparent;
    border: 0;
  }
  .scene code {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .line {
    display: block;
    min-height: 1.5em;
  }
  .cmd {
    color: #fff;
    font-weight: 600;
  }
  .prompt {
    color: var(--term-accent);
  }
  .note {
    color: var(--term-dim);
    font-style: italic;
  }
  .exit {
    color: #ffa657;
  }
  .line.typing .cursor::after {
    content: "▋";
    color: var(--term-accent);
  }
  .line.hidden {
    display: none;
  }
</style>

<style
  set:html={scenes
    .map(
      (s) =>
        `#term-${s.id}:checked ~ .scene-${s.id} { display: block; }
#term-${s.id}:checked ~ .tabs label[for="term-${s.id}"] { color: var(--term-fg); background: #30363d; }
#term-${s.id}:focus-visible ~ .tabs label[for="term-${s.id}"] { outline: 2px solid var(--term-accent); }`,
    )
    .join("\n")}
/>

<script>
  // Types the shown scene's lines one at a time: commands character by
  // character, output a line at a time. Without JavaScript, or with reduced
  // motion, every line is simply there.
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  for (const term of document.querySelectorAll<HTMLElement>("[data-terminal]")) {
    if (reduced) continue;
    let run = 0;
    const play = async (id: string) => {
      const mine = ++run;
      const scene = term.querySelector<HTMLElement>(`[data-scene="${id}"]`);
      if (!scene) return;
      const lines = [...scene.querySelectorAll<HTMLElement>(".line")];
      const texts = lines.map((l) => l.innerHTML);
      lines.forEach((l) => l.classList.add("hidden"));
      scene.scrollTop = 0;
      for (const [i, line] of lines.entries()) {
        if (mine !== run) break;
        line.classList.remove("hidden");
        if (line.classList.contains("cmd")) {
          const text = line.textContent ?? "";
          const prompt = line.querySelector(".prompt")?.outerHTML ?? "";
          const body = text.replace(/^\$ /, "").trimEnd();
          line.classList.add("typing");
          for (let n = 0; n <= body.length && mine === run; n += 2) {
            line.innerHTML = `${prompt}${escape(body.slice(0, n))}<span class="cursor"></span>`;
            await sleep(18);
          }
          line.classList.remove("typing");
          line.innerHTML = texts[i];
          await sleep(350);
        } else {
          await sleep(line.classList.contains("note") ? 300 : 45);
        }
        scene.scrollTop = scene.scrollHeight;
      }
      // Interrupted by another tab: leave this scene whole.
      lines.forEach((l, i) => {
        l.classList.remove("hidden", "typing");
        l.innerHTML = texts[i];
      });
    };
    for (const input of term.querySelectorAll<HTMLInputElement>(".tab-input")) {
      input.addEventListener("change", () => play(input.id.replace(/^term-/, "")));
    }
    const first = term.querySelector<HTMLInputElement>(".tab-input:checked");
    const seen = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting) && first) {
        seen.disconnect();
        play(first.id.replace(/^term-/, ""));
      }
    });
    seen.observe(term);
  }

  function escape(s: string) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }
</script>
