{
  "name": "agent-harness-adapter",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "containerEnv": {
    "SCCACHE_DIR": "/home/vscode/.cache/sccache",
    "CONTAINER_WORKSPACE_FOLDER": "${containerWorkspaceFolder}",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "mounts": [
    // Keep high-churn build artifacts on a local named volume instead virtiofs workspace share
    // It intermittently returns EACCES on the burst of parallel rename
    "source=agent-harness-kit-cargo-target,target=${containerWorkspaceFolder}/target,type=volume",
    "source=agent-harness-kit-sccache,target=/home/vscode/.cache/sccache,type=volume",
    "source=agent-harness-kit-mise-data,target=/home/vscode/.local/share/mise,type=volume",
    // Claude Code
    "source=agent-harness-kit-claude,target=/home/vscode/.claude,type=volume",
    "source=${localEnv:HOME}/.claude/CLAUDE.md,target=/home/vscode/.claude/CLAUDE.md,type=bind,readonly",
    "source=${localEnv:HOME}/.claude/commands,target=/home/vscode/.claude/commands,type=bind,readonly",
    "source=${localEnv:HOME}/.claude/agents,target=/home/vscode/.claude/agents,type=bind,readonly",
    "source=${localEnv:HOME}/.claude/skills,target=/home/vscode/.claude/skills,type=bind,readonly"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "editor.tabSize": 2,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      },
      "extensions": [
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "hverlin.mise-vscode",
        "niceandfair.vscode-tombi",
        "rust-lang.rust-analyzer"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "postStartCommand": "bash .devcontainer/scripts/post-start.sh",
  "remoteUser": "vscode"
}
